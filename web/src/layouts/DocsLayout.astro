---
import Base from "./Base.astro";
import { getCollection } from "astro:content";
import { LINKS } from "../consts";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  lede?: string;
}

const { title, description, eyebrow = "// docs", lede } = Astro.props;

// Sidebar is derived from the docs collection (sorted by frontmatter `order`),
// so adding a docs/*.md page is all it takes to appear here.
const docs = (await getCollection("docs")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
const items = docs.map((d) => ({
  label: d.data.navLabel ?? d.data.title,
  href: `/docs/${d.id}/`,
}));
// Changelog isn't a docs/ page (it renders CHANGELOG.md), but belongs in the nav.
items.push({ label: "Changelog", href: "/changelog/" });

const path = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => href.replace(/\/$/, "") === path;
const pageTitle = `${title} · syscert docs`;
---

<Base title={pageTitle} description={description} path={Astro.url.pathname}>
  <div class="docs">
    <div class="shell docs-shell">
      <aside class="docs-side">
        <p class="label-mono docs-side-h">// documentation</p>
        <nav aria-label="Documentation">
          <ul>
            {items.map((i) => (
              <li>
                <a
                  href={i.href}
                  class={isActive(i.href) ? "is-active" : undefined}
                  aria-current={isActive(i.href) ? "page" : undefined}
                >
                  {i.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="docs-side-foot">
          <a href={LINKS.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={LINKS.issues} target="_blank" rel="noopener">Report an issue ↗</a>
        </div>
      </aside>

      <article class="doc-prose">
        <header class="doc-head">
          <p class="label-mono">{eyebrow}</p>
          <h1>{title}</h1>
          {lede && <p class="doc-lede">{lede}</p>}
        </header>
        <slot />
      </article>
    </div>
  </div>
</Base>

<style>
  .docs { padding-block: 40px 64px; }
  .docs-shell {
    display: grid;
    grid-template-columns: 224px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  .docs-side { position: sticky; top: 86px; align-self: start; min-width: 0; }
  .docs-side-h { margin: 0 0 14px; color: var(--faint); }
  .docs-side nav ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 2px; border-left: 1px solid var(--line);
  }
  .docs-side nav a {
    display: block; padding: 8px 14px; margin-left: -1px;
    border-left: 2px solid transparent;
    font-family: var(--font-mono); font-size: 13.5px; color: var(--muted);
    transition: color 0.16s, border-color 0.16s, background 0.16s;
  }
  .docs-side nav a:hover { color: var(--ink); }
  .docs-side nav a.is-active {
    color: var(--cyan); border-left-color: var(--cyan);
    background: color-mix(in oklab, var(--cyan) 7%, transparent);
  }
  .docs-side-foot {
    margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--line-soft);
    display: grid; gap: 9px; font-family: var(--font-mono); font-size: 12.5px;
  }
  .docs-side-foot a { color: var(--faint); }
  .docs-side-foot a:hover { color: var(--cyan); }

  .doc-head { margin-bottom: 36px; padding-bottom: 26px; border-bottom: 1px solid var(--line-soft); }
  .doc-head .label-mono { margin: 0 0 14px; }
  .doc-head h1 {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(1.9rem, 4vw, 2.6rem); letter-spacing: -0.035em; line-height: 1.08; margin: 0;
  }
  .doc-lede { color: var(--muted); font-size: 17px; line-height: 1.6; max-width: 62ch; margin: 16px 0 0; }

  @media (max-width: 880px) {
    .docs-shell { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .docs-side { position: static; top: auto; }
    /* wrap the docs nav into pills so every link stays visible — no clipped scroll row */
    .docs-side nav ul { display: flex; flex-wrap: wrap; gap: 8px; border-left: 0; }
    .docs-side nav a { margin-left: 0; border: 1px solid var(--line); border-radius: 8px; padding: 7px 12px; }
    .docs-side nav a.is-active {
      border-color: color-mix(in oklab, var(--cyan) 55%, var(--line));
      color: var(--cyan); background: color-mix(in oklab, var(--cyan) 8%, transparent);
    }
    .docs-side-foot { display: none; }
  }
</style>
