---
interface Props {
  command: string;
  prompt?: string;
  cursor?: boolean;
  size?: "lg" | "md";
}
const { command, prompt = "$", cursor = false, size = "md" } = Astro.props;
---
<div class={`copycmd copycmd-${size}`} data-cmd={command}>
  <code class="copycmd-text">
    <span class="copycmd-prompt">{prompt}</span>
    <span class="copycmd-body">{command}</span>{cursor && <span class="cursor"></span>}
  </code>
  <button class="copycmd-btn" type="button" aria-label="Copy command to clipboard">
    <span class="copycmd-ico" aria-hidden="true">⧉</span>
    <span class="copycmd-label">copy</span>
  </button>
</div>

<style>
  .copycmd {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    background: var(--bg-deep);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 13px 13px 13px 18px;
    box-shadow: inset 0 1px 0 #ffffff08;
  }
  .copycmd-text {
    font-family: var(--font-mono);
    color: var(--ink);
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .copycmd-text::-webkit-scrollbar { display: none; }
  .copycmd-lg .copycmd-text { font-size: 15px; }
  .copycmd-md .copycmd-text { font-size: 13.5px; }
  .copycmd-prompt { color: var(--green); margin-right: 8px; user-select: none; }
  .copycmd-btn {
    flex: none;
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-mono); font-size: 12px;
    padding: 7px 12px; border-radius: 8px;
    border: 1px solid color-mix(in oklab, var(--cyan) 30%, var(--line));
    background: color-mix(in oklab, var(--cyan) 8%, transparent);
    color: var(--cyan); cursor: pointer;
    transition: background 0.16s, border-color 0.16s, transform 0.16s;
  }
  .copycmd-btn:hover { background: color-mix(in oklab, var(--cyan) 16%, transparent); transform: translateY(-1px); }
  .copycmd.copied .copycmd-btn { color: var(--green); border-color: color-mix(in oklab, var(--green) 45%, var(--line)); background: color-mix(in oklab, var(--green) 12%, transparent); }
</style>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLButtonElement>(".copycmd-btn");
    if (!btn) return;
    const wrap = btn.closest<HTMLElement>(".copycmd");
    if (!wrap) return;
    const cmd = wrap.dataset.cmd ?? "";
    navigator.clipboard.writeText(cmd).then(() => {
      const label = wrap.querySelector(".copycmd-label");
      const ico = wrap.querySelector(".copycmd-ico");
      wrap.classList.add("copied");
      if (label) label.textContent = "copied";
      if (ico) ico.textContent = "✓";
      window.setTimeout(() => {
        wrap.classList.remove("copied");
        if (label) label.textContent = "copy";
        if (ico) ico.textContent = "⧉";
      }, 1600);
    });
  });
</script>
