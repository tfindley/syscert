---
import { LINKS, SITE } from "../consts";

const cols = [
  {
    title: "Project",
    links: [
      { label: "GitHub", href: LINKS.github, ext: true },
      { label: "Issues", href: LINKS.issues, ext: true },
      { label: "Releases", href: LINKS.releases, ext: true },
      { label: "Security policy", href: LINKS.security, ext: true },
    ],
  },
  {
    title: "Docs",
    links: [
      { label: "Quick start", href: "/docs/quick-start/" },
      { label: "Configuration", href: "/docs/configuration/" },
      { label: "Advanced install", href: "/docs/advanced-install/" },
      { label: "Sample configs", href: "/docs/examples/" },
      { label: "Distributing certs", href: "/docs/distributing/" },
      { label: "Troubleshooting", href: "/docs/troubleshooting/" },
      { label: "FAQ", href: "/docs/faq/" },
      { label: "Roadmap", href: "/docs/roadmap/" },
      { label: "Changelog", href: "/changelog/" },
    ],
  },
  {
    title: "Support",
    links: [
      { label: "☕ Ko-fi", href: LINKS.kofi, ext: true },
      { label: "tfindley.co.uk", href: LINKS.author, ext: true },
    ],
  },
];
---
<footer class="ft">
  <div class="shell ft-grid">
    <div class="ft-brand">
      <div class="ft-logo"><span class="brand-dot"></span> syscert</div>
      <p class="ft-tag">{SITE.tagline}</p>
    </div>
    {cols.map((c) => (
      <nav class="ft-col" aria-label={c.title}>
        <h2 class="ft-h">{c.title}</h2>
        <ul>
          {c.links.map((l) => (
            <li>
              <a href={l.href} {...(l.ext ? { target: "_blank", rel: "noopener" } : {})}>
                {l.label}{l.ext && <span class="ext"> ↗</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="shell ft-bottom">
    <span>
      <a href={LINKS.license} target="_blank" rel="noopener">AGPL-3.0</a>
      · © {new Date().getFullYear()} tfindley
    </span>
    <span class="ft-status"><span class="ft-pip"></span> {SITE.status}</span>
  </div>
</footer>

<style>
  .ft { margin-top: 96px; border-top: 1px solid var(--line); background: linear-gradient(180deg, transparent, color-mix(in oklab, var(--bg-deep) 60%, transparent)); }
  .ft-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 40px; padding-block: 56px 40px; }
  .ft-logo { display: inline-flex; align-items: center; gap: 9px; font-family: var(--font-display); font-weight: 700; letter-spacing: -0.03em; }
  .ft-logo .brand-dot { width: 8px; height: 8px; border-radius: 99px; background: var(--cyan); }
  .ft-tag { color: var(--muted); font-size: 14px; max-width: 30ch; margin: 12px 0 16px; }
  .ft-h { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--faint); margin: 0 0 14px; }
  .ft-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ft-col a { color: var(--muted); font-size: 14px; transition: color 0.16s; }
  .ft-col a:hover { color: var(--cyan); }
  .ext { color: var(--faint); }
  .ft-bottom { display: flex; align-items: center; justify-content: space-between; padding-block: 20px 30px; border-top: 1px solid var(--line-soft); font-family: var(--font-mono); font-size: 12.5px; color: var(--faint); }
  .ft-bottom a:hover { color: var(--cyan); }
  .ft-status { display: inline-flex; align-items: center; gap: 8px; }
  .ft-pip { width: 7px; height: 7px; border-radius: 99px; background: var(--amber, #f5b14c); box-shadow: 0 0 9px 1px color-mix(in oklab, #f5b14c 55%, transparent); }
  @media (max-width: 820px) {
    .ft-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    .ft-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .ft-bottom { flex-direction: column; gap: 10px; align-items: flex-start; }
  }
</style>
