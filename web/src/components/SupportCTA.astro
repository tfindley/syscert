---
import { LINKS } from "../consts";
---
<section class="sec" id="support">
  <div class="shell">
    <div class="card support">
      <div class="support-glow" aria-hidden="true"></div>
      <div class="support-body">
        <p class="label-mono">// independent &amp; open source</p>
        <h2 class="support-title">Support this project.</h2>
        <p class="support-d">
          syscert is free, AGPL-3.0, and built in the open. If it saved you a 2&nbsp;a.m. page,
          a coffee keeps it moving.
        </p>
      </div>
      <a href={LINKS.kofi} target="_blank" rel="noopener" class="btn btn-primary support-btn">
        ☕ Support on Ko-fi
      </a>
    </div>
  </div>
</section>

<style>
  .support { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding: 36px 40px; position: relative; overflow: hidden; }
  .support-glow { position: absolute; inset: 0; background: radial-gradient(420px 200px at 12% 0%, color-mix(in oklab, var(--green) 16%, transparent), transparent 70%); pointer-events: none; }
  .support-body { position: relative; }
  .support-title { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 700; letter-spacing: -0.03em; margin: 12px 0 10px; }
  .support-d { color: var(--muted); font-size: 15px; max-width: 52ch; margin: 0; }
  .support-btn { flex: none; position: relative; font-size: 14px; }
  @media (max-width: 720px) {
    .support { flex-direction: column; align-items: flex-start; padding: 30px 26px; }
  }
</style>
