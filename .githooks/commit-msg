#!/usr/bin/env sh
# Conventional Commits check for SysCert.
# Enable once per clone:  git config core.hooksPath .githooks
#
# Format:  <type>[(scope)][!]: <description>
# Types:   feat fix docs style refactor perf test build ci chore revert
msg=$(head -n1 "$1")

# allow machine-generated / in-progress messages through
case "$msg" in
  Merge\ *|Revert\ *|fixup!*|squash!*|"") exit 0 ;;
esac

if printf '%s' "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'; then
  exit 0
fi

cat >&2 <<EOF
✗ Not a Conventional Commit:
    $msg

  format:  <type>[(scope)][!]: <description>
  types:   feat fix docs style refactor perf test build ci chore revert
  break:   add ! (or a "BREAKING CHANGE:" footer) for a breaking change
  example: feat(acme): add dns-persist-01 challenge support
EOF
exit 1
