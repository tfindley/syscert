{{ ansible_managed | comment }}
# syscert — hostname-based system TLS certificate service (oneshot, timer-driven).
# Keep the hardening block (ADR-0028) in sync with packaging/systemd/syscert.service.
{% set caps = syscert_capabilities | join(' ') %}

[Unit]
Description=SysCert — ensure system TLS certificate is issued, renewed, and distributed
Documentation=https://github.com/tfindley/syscert
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ syscert_user }}
Group={{ syscert_group }}
EnvironmentFile=-{{ syscert_defaults_path }}
EnvironmentFile=-{{ syscert_secrets_path }}
ExecStart={{ syscert_bin_path }}{{ (' ' ~ syscert_service_exec_extra_args) if syscert_service_exec_extra_args | length > 0 else '' }}

# Hardening (ADR-0028)
NoNewPrivileges=true
ProtectSystem=strict
# ProtectSystem=strict makes the WHOLE hierarchy read-only, so every path syscert
# writes must be listed here — the store AND each distribute target's directory.
# Miss one and `ensure` issues the cert fine, then fails at the distribute step with
# a read-only filesystem error. The static unit can only name the store; the role
# knows syscert_distribute, so it derives the rest (and creates those directories).
ReadWritePaths={{ ([syscert_store_path] + syscert_writable_dirs) | unique | join(' ') }}
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# CAP_CHOWN lets distribution set target ownership; CAP_NET_BIND_SERVICE is added
# automatically when the challenge serves on :80/:443 (http-01/tls-alpn-01 or IP SANs).
AmbientCapabilities={{ caps }}
CapabilityBoundingSet={{ caps }}

# No [Install]: triggered by syscert.timer, not enabled directly.
