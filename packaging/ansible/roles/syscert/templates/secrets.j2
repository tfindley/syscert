{{ ansible_managed | comment }}
# DNS provider / CA credentials, sourced by the systemd unit (EnvironmentFile).
# Mode 0640, owned root:{{ syscert_group }} — never world-readable. One KEY=value per line.
# Values are written unquoted: systemd keeps spaces, '#', '$' and quotes as-is, so quoting
# would only add a layer both readers then strip. Two caveats the role asserts or documents:
# leading/trailing whitespace is trimmed, and a backslash is an escape to systemd but a
# literal to `syscert --env-file`, so avoid backslashes in credentials.
# Look up your DNS provider's variable names at https://go-acme.github.io/lego/dns/
{% for key, value in syscert_secrets.items() %}
{{ key }}={{ value }}
{% endfor %}
