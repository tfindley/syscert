# anchored to repo root so they don't match web/
/CLAUDE.md
.claude/
# user-facing docs (docs/*.md) are committed and rendered by the site;
# only the internal engineering notes stay local
/docs/internal/

# Generated by scripts/prerelease.sh (ephemeral audit report)
/RELEASE-READINESS.md

# Go build artifacts
/syscert
/dist/
*.exe
*.test
*.out
coverage.*

# Local env / secrets (never commit)
*.env
*.local.toml
secrets.toml

/config.sample.toml
/environment.sample
*.code-workspace
/syscert-store

# Repowise (generated local tooling; machine-specific paths)
/.repowise/
/.mcp.json

# Python virtual environments
.venv/

# Ansible
.ansible/